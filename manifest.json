{
  "manifest_version": 3,
  "name": "Hide diff comment rows",
  "version": "1.0",
  "action": { "default_title": "Toggle comment rows" },
  "background": { "service_worker": "bg.js" },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+C", "mac": "Alt+Shift+C" }
    }
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "css": ["hide.css"],
      "js": ["toggle.js"]
    }
  ]
}
